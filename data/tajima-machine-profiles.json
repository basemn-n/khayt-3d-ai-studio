  "digitizing_recipe_policy": {
    "default_numeric_values": "none",
    "required_properties": [
      "fabric_class",
      "stitch_type",
      "density",
      "underlay",
      "pull_compensation",
      "stitch_length",
      "tie_in",
      "tie_off",
      "source_evidence"
    ],
    "evidence_status": [
      "manufacturer_documented",
      "DG_preset_documented",
      "operator_supplied",
      "sample_calibrated",
      "not_verified"
    ],
    "unverified_values_must_be_null": true,
    "note": "Do not infer thread tension, bobbin tension, presser-foot pressure, needle size, or machine speed from DST."
  },
  "production_qa": {
    "required": [
      "design_bounds_mm",
      "stitch_count",
      "color_change_count",
      "jump_count",
      "trim_count_if_available",
      "stitch_type_summary",
      "sequence_review",
      "long_stitch_review",
      "short_stitch_review",
      "overlap_density_review",
      "frame_compatibility_operator_confirmation",
      "physical_sew_out_required"
    ],
    "pass_label": "software_checks_passed_physical_sew_out_required"
  },
  "global_frame_compatibility_source": "https://www.tajima.com/product/frame/",
  "primary_workflows": [
    {
      "id": "FULL_PANEL",
      "label": "Full energy fabric sheet — embroider first, cut garment pieces afterward",
      "priority": 1,
      "required_inputs": [
        "fabric_sheet_width_mm",
        "fabric_sheet_height_mm",
        "approved_garment_cut_pattern",
        "piece_layout",
        "grain_direction",
        "seam_allowance_mm",
        "embroidery_clearance_from_cut_lines_mm",
        "placement_origin",
        "fabric_class",
        "operator_confirmed_machine_model",
        "operator_confirmed_frame",
        "registration_or_repositioning_plan_if_required"
      ],
      "machine_guidance": "Treat the entire flat fabric sheet as one workpiece. Arrange the approved border, left/right sleeves, back, and front cutting pieces on the same sheet; embroider the planned regions first, then the cutter cuts the pieces. Prefer a verified flat-type machine/frame for cut fabric before garment assembly. Actual frame and field compatibility remain operator-confirmed.",
      "source_urls": [
        "https://www.tajima.support/Manual_machine/%E8%8B%B1%E8%AA%9E/M-EMB-05-EN.pdf",
        "https://www.tajima.com/product/frame/",
        "https://www.tajima.com/product/tmcp-vf/"
      ],
      "cutting_and_embroidery_rules": {
        "workflow_order": [
          "prepare_full_fabric_sheet",
          "approve_garment_cut_pattern",
          "nest_border_sleeves_back_front_pieces",
          "place_embroidery_in_each_piece_region",
          "review_cut_lines_seam_allowances_and_registration",
          "export_stitches_and_separate_cut_layout",
          "embroider_fabric",
          "cut_pieces",
          "sew_garment"
        ],
        "supported_piece_types": [
          "border_hem",
          "sleeve_left",
          "sleeve_right",
          "back_panel",
          "front_left",
          "front_right",
          "additional_cutter_defined_piece"
        ],
        "geometry_layers": {
          "embroidery_stitches": "exported_to_DST",
          "cutting_outlines": "non_stitch_guides_not_exported_to_DST",
          "registration_guides": "non_stitch_guides_not_exported_to_DST",
          "seam_allowance_and_no_stitch_zones": "protected_layout_regions_not_exported_to_DST"
        },
        "must_not_assume_garment_dimensions": true,
        "must_not_auto_scale_crop_or_segment_without_approval": true,
        "must_confirm_left_right_mirroring": true,
        "must_check_stitch_clearance_from_cut_lines": true,
        "must_detect_piece_overlap_and_stitch_crossing_between_cut_pieces": true,
        "cut_plan_approval_required": true
      }
    },
    {
      "id": "BORDER_HEM",
      "label": "Border / hem",
      "priority": 2,
      "required_inputs": [
        "border_length_mm",
        "border_width_mm",
        "path_direction",
        "start_margin_mm",
        "end_margin_mm",
        "fabric_class",
        "operator_confirmed_frame"
      ],
      "machine_guidance": "Use border-frame workflow only where supported by exact model; continuous/repositioned pattern workflow requires machine-specific confirmation.",
      "source_urls": [
        "https://www.tajima.com/product/frame/"
      ]
    },
    {
      "id": "SLEEVE_HAND",
      "label": "Sleeve / hand section",
      "priority": 3,
      "required_inputs": [
        "placement_width_mm",
        "placement_height_mm",
        "left_or_right",
        "mirror_confirmation",
        "fabric_class",
        "operator_confirmed_frame"
      ],
      "machine_guidance": "Confirm physical access, frame and clearance for exact garment and machine. Do not assume all cylinder frames fit every sleeve.",
      "source_urls": [
        "https://www.tajima.com/product/frame/",
        "https://www.tajima.support/Manual_machine/%E8%8B%B1%E8%AA%9E/M-EMB-05-EN.pdf"
      ]
    },
    {
      "id": "GARMENT_PANEL",
      "label": "Garment front/back panel",
      "priority": 4,
      "required_inputs": [
        "panel_identifier",
        "panel_width_mm",
        "panel_height_mm",
        "placement_origin",
        "fabric_class",
        "operator_confirmed_frame"
      ],
      "machine_guidance": "For cut garment pieces prioritize flat-type machine; for finished garment assess cylinder-type access and exact frame compatibility.",
      "source_urls": [
        "https://www.tajima.support/Manual_machine/%E8%8B%B1%E8%AA%9E/M-EMB-05-EN.pdf",
        "https://www.tajima.com/product/frame/"
      ]
    }
  ],
  "machine_family_guidance": {
    "flat_type": {
      "preferred_for": [
        "cut fabric",
        "full panels",
        "large continuous artwork",
        "garment parts before sewing"
      ],
      "source_urls": [
        "https://www.tajima.support/Manual_machine/%E8%8B%B1%E8%AA%9E/M-EMB-05-EN.pdf",
        "https://www.tajima.com/product/frame/"
      ]
    },
    "cylinder_type": {
      "preferred_for": [
        "finished garments where tubular mounting is suitable",
        "caps and cylindrical products",
        "accessible garment sections"
      ],
      "source_urls": [
        "https://www.tajima.support/Manual_machine/%E8%8B%B1%E8%AA%9E/M-EMB-05-EN.pdf"
      ]
    }
  },
  "full_panel_layout_policy": {
    "workpiece_model": "one_complete_flat_fabric_sheet_before_garment_assembly",
    "cut_after_embroidery": true,
    "piece_types": [
      "border_hem",
      "sleeve_left",
      "sleeve_right",
      "back_panel",
      "front_left",
      "front_right",
      "additional_cutter_defined_piece"
    ],
    "required_pattern_source": "cutter_or_tailor_supplied_or_user_approved_pattern",
    "separate_geometry_layers": [
      "embroidery_stitches",
      "cutting_outlines",
      "registration_guides",
      "seam_allowance_no_stitch_zones"
    ],
    "only_embroidery_stitches_export_to_dst": true,
    "cutting_layout_report_required": true,
    "fabric_sheet_dimensions_must_be_user_supplied": true,
    "seam_allowance_and_embroidery_clearance_must_be_user_or_pattern_supplied": true,
    "no_automatic_garment_measurement_guessing": true,
    "no_silent_scale_crop_or_reposition": true,
    "operator_must_approve_frame_and_registration_strategy": true
  }
}
