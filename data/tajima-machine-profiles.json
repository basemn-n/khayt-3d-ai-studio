  "digitizing_recipe_policy": {
    "default_numeric_values": "none",
    "required_properties": [
      "fabric_class",
      "stitch_type",
      "density",
      "underlay",
      "pull_compensation",
      "stitch_length",
      "tie_in",
      "tie_off",
      "source_evidence"
    ],
    "evidence_status": [
      "manufacturer_documented",
      "DG_preset_documented",
      "operator_supplied",
      "sample_calibrated",
      "not_verified"
    ],
    "unverified_values_must_be_null": true,
    "note": "Do not infer thread tension, bobbin tension, presser-foot pressure, needle size, or machine speed from DST."
  },
  "production_qa": {
    "required": [
      "design_bounds_mm",
      "stitch_count",
      "color_change_count",
      "jump_count",
      "trim_count_if_available",
      "stitch_type_summary",
      "sequence_review",
      "long_stitch_review",
      "short_stitch_review",
      "overlap_density_review",
      "frame_compatibility_operator_confirmation",
      "physical_sew_out_required"
    ],
    "pass_label": "software_checks_passed_physical_sew_out_required"
  },
